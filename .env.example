# ─────────────────────────────────────────────────────────────────────────────
# TAB — environment
# Copy to .env (gitignored). Testnet first. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Pollar (dashboard.pollar.xyz → your app → Developers → API keys)
# Test mode app keys start with pub_testnet_ / sec_testnet_.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_replace_me
POLLAR_SECRET_KEY=sec_testnet_replace_me

# Pollar environment is implied by the key prefix: testnet | mainnet
NEXT_PUBLIC_POLLAR_CHAIN=STELLAR
# Optional: force the settlement asset. Default USDC. Use XLM if the testnet
# app has no USDC asset enabled yet.
NEXT_PUBLIC_SETTLEMENT_ASSET=USDC
NEXT_PUBLIC_USDC_ISSUER=
# The Pollar application id. Enforces that the verified token was issued for
# this app, not another one.
POLLAR_APPLICATION_ID=

# API
PORT=4000
API_BASE_URL=http://localhost:4000
DATABASE_PATH=./data/tab.db
SESSION_SECRET=dev_only_change_me_32_chars_minimum
WEB_ORIGIN=http://localhost:3000
DEPOT_ORIGIN=http://localhost:3001
# Public URL used by docker-compose (e.g. https://tab-yourname.duckdns.org).
TAB_PUBLIC_URL=http://localhost:8080
# Domain for the host-level Caddy TLS config.
TAB_DOMAIN=

# Demo behaviour
# 1 = simulated card network (testnet). 0 = real Pollar Cards rail (live+KYC).
TAB_DEMO_MODE=1
# Auto-settle agent purchases without a human approval click when under the
# card's autoApproveUnder threshold. The browser signer must still be online.
TAB_SIGNER_MODE=browser

# Merchant treasury (testnet only). Generated by `pnpm seed` if empty.
# The seed script creates and funds these with friendbot.
STELLAR_MERCHANT_SECRET=
STELLAR_MERCHANT_ADDRESS=
SOLANA_MERCHANT_ADDRESS=
